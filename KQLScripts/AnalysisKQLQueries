CellTowerLogs
| take 10

NetworkAlarms
| take 10

// Congested cells right now
CellTowerLogs
| where todatetime(event_time) > ago(10m)
| summarize prb = avg(prb_utilisation_pct),
            tput = avg(throughput_mbps),
            drop = avg(drop_rate_pct),
            users = max(active_users)
  by cell_id, site_id, city, technology, band
| where prb > 50
| order by prb desc

// KPI collapse over time
CellTowerLogs
| where ingestion_time() > ago(1h) and  congested == true and alarm_active == true
| summarize avg_prb = avg(prb_utilisation_pct),
            avg_tput = avg(throughput_mbps),
            avg_drop = avg(drop_rate_pct)
  by bin(todatetime(event_time), 5s)
| render timechart 

// Alarms by severity and city
NetworkAlarms
| where todatetime(event_time) > ago(1h) and state == "raised"
| summarize alarms = count(), cells = dcount(cell_id)
  by severity, domain, city
| order by alarms desc

// Alarm bursts - 5+ alarms on one site in 5 minutes
NetworkAlarms
| where todatetime(event_time) > ago(1h) and state == "raised"
| summarize alarm_count = count(), codes = make_set(alarm_code)
  by site_id, bin(todatetime(event_time), 5m)
| where alarm_count >= 5
| order by alarm_count desc

// Live KPIs joined to the Lakehouse site dimension to get details like site_name, morphology
CellTowerLogs
| where todatetime(event_time) > ago(1h)
| summarize prb = avg(prb_utilisation_pct), tput = avg(throughput_mbps)
  by cell_id, site_id
| lookup kind=leftouter dim_site on site_id
| project site_name, city, morphology, vendor, cell_id, prb, tput
| order by prb desc


// Which vip subscribers are on congested cells
CellTowerLogs
| where todatetime(event_time) > ago(10m) and congested == true
| summarize prb = avg(prb_utilisation_pct) by site_id
| join kind=inner (dim_subscriber) on $left.site_id == $right.home_site_id
| where vip_flag == "Y"
//| summarize affected = count(), vips = countif(vip_flag == "Y") 


// This KQL query was generated by AI:
// can you find details on incident id INC-001 including impact and rootcause?
//
CellTowerLogs
| where incident_id == "INC-001"
| extend event_time_dt = todatetime(event_time)
| summarize
    start_time = min(event_time_dt),
    end_time = max(event_time_dt),
    impacted_cells = dcount(cell_id),
    impacted_sites = dcount(site_id),
    avg_prb_utilisation_pct = avg(prb_utilisation_pct),
    max_prb_utilisation_pct = max(prb_utilisation_pct),
    avg_rrc_success_rate_pct = avg(rrc_success_rate_pct),
    min_rrc_success_rate_pct = min(rrc_success_rate_pct),
    avg_drop_rate_pct = avg(drop_rate_pct),
    max_drop_rate_pct = max(drop_rate_pct),
    avg_throughput_mbps = avg(throughput_mbps),
    min_throughput_mbps = min(throughput_mbps),
    avg_active_users = avg(active_users),
    max_active_users = max(active_users),
    avg_cpu_load_pct = avg(cpu_load_pct),
    max_cpu_load_pct = max(cpu_load_pct),
    congested_samples = countif(congested == true),
    total_samples = count()
| extend join_key = 1
| join kind=leftouter (
    NetworkAlarms
    | where incident_id == "INC-001"
    | extend event_time_dt = todatetime(event_time)
    | summarize
        first_alarm_time = min(event_time_dt),
        last_alarm_time = max(event_time_dt),
        alarm_count = count(),
        critical_alarms = countif(severity == "Critical"),
        major_alarms = countif(severity == "Major"),
        minor_alarms = countif(severity == "Minor"),
        service_affecting_alarms = countif(service_affecting == true),
        domains = make_set(domain),
        alarm_codes = make_set(alarm_code),
        alarm_names = make_set(alarm_name)
    | extend join_key = 1
) on $left.join_key == $right.join_key


